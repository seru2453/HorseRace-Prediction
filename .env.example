DATABASE_URL=sqlite:///data/db/keiba.sqlite3
PORT=8000
DEPLOYMENT_MODE=local
# Set only after manually verifying the current public JRA URL structure.
# JRA_OFFICIAL_URL_TEMPLATE=https://www.jra.go.jp/...
AUTO_PIPELINE_ENABLED=1
AUTO_PIPELINE_INTERVAL_SECONDS=3600
AUTO_PIPELINE_INITIAL_DELAY_SECONDS=30
AUTO_PREDICTION_LEAD_MINUTES=120

# Optional TypeSafe Jev qualitative assessment. It is enabled automatically when a key is present.
# TYPESAFE_API_KEY=
# JEV_ENABLED=1
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_SECONDS=10
